{
  "name": "official-documents-backend",
  "version": "1.0.0",
  "description": "Sistema Web para Gestão de Documentos Oficiais - Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "migration:run": "ts-node src/database/run-migrations.ts",
    "migration:seed": "ts-node src/database/seeds/seed.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "xlsx": "^0.18.5",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "mime-types": "^2.1.35",
    "file-type": "^16.5.4",
    "crypto": "^1.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.0.0",
    "@types/mime-types": "^2.1.4",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0"
  }
}
